		#autoLOC_443389 = <color=<<1>>>Parts:</color>
		#autoLOC_443401 = <color=<<1>>>Mass:</color>
		#autoLOC_443405 = <color=<<1>>><<2>>t / <<3>>t</color>
		#autoLOC_443409 = <color=<<1>>><<2>>t</color>
