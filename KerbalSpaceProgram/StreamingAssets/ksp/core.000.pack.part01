		#autoLOC_8007310 = <color=#FFBC00><b>Node Missing</b></color>
		#autoLOC_8007311 = The linked node does not exist anymore
		#autoLOC_8007312 = On: <<1>>\n Longitude: <<2>>Â° \nLatitude: <<3>>Â° \n Radius: <<4>>km
		#autoLOC_8007313 = On: <<1>>\n Longitude: <<2>>Â° \nLatitude: <<3>>Â° \n Radius: <<4>>km\n Height:<<5>>km
